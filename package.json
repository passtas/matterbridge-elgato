{
  "name": "matterbridge-elgato",
  "version": "0.1.1",
  "description": "Matterbridge plugin for Elgato lights: Key Light, Key Light Air and Light Strip over Matter",
  "keywords": [
    "alexa",
    "apple-home",
    "elgato",
    "google-home",
    "homeautomation",
    "key-light",
    "key-light-air",
    "light-strip",
    "matter",
    "matterbridge",
    "plugin"
  ],
  "homepage": "https://github.com/passtas/matterbridge-elgato#readme",
  "bugs": {
    "url": "https://github.com/passtas/matterbridge-elgato/issues"
  },
  "license": "MIT",
  "author": "passtas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/passtas/matterbridge-elgato.git"
  },
  "bin": {
    "matterbridge-elgato": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "matterbridge-elgato.config.json",
    "matterbridge-elgato.schema.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist coverage .cache",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --coverage",
    "test:live": "vitest run test/live.test.ts",
    "mock": "node scripts/mock-elgato.ts",
    "dev": "matterbridge -bridge",
    "link": "npm link --no-fund --no-audit matterbridge",
    "add": "matterbridge -add .",
    "remove": "matterbridge -remove .",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli/index.js', 0o755)\""
  },
  "dependencies": {
    "bonjour-service": "1.4.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0 || >=22.13.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "allowScripts": {
    "lefthook@2.1.12": true
  }
}
